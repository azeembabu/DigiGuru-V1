# Copy to `.env` for local development only. Never commit `.env` (see
# `.gitignore`) and never use a plain `.env` file in production - secrets
# there come from AWS Secrets Manager / Vault (`.claude/rules/security.md`).

# Postgres 16, matching infra/docker-compose.yml.
DATABASE_URL=postgres://digiguru:digiguru_dev@localhost:5432/digiguru

# Redis 7, matching infra/docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Qdrant (read by dg-core's Config now; consumed starting Phase 2).
QDRANT_URL=http://localhost:6333

# HMAC secrets for the access-token JWT and the refresh-token hash. Generate
# with e.g. `openssl rand -base64 48`. Must differ from each other, and must
# be rotated (via a secrets manager) in any non-local environment.
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-secret

# Gateway bind port. Defaults to 8080 if unset.
PORT=8080

# Log verbosity, passed to `tracing_subscriber::EnvFilter`.
RUST_LOG=info
