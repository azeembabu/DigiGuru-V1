// Digi Guru - Prisma Schema
// Phase 1: Database & Prisma Layer
// PostgreSQL 16 + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Status {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model users {
  id            String     @id @default(cuid())
  email         String     @unique
  password_hash String
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  last_login_at DateTime?

  // Relations
  student        students?
  admin          admins?
  sessions       sessions[]
  password_resets password_resets[]
  audit_logs     audit_logs[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model students {
  id           String   @id @default(cuid())
  user_id      String   @unique
  full_name    String
  roll_number  String   @unique
  phone_number String
  program_id   String
  semester_id  String
  lsc_id       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  program  programs  @relation(fields: [program_id], references: [id], onDelete: Restrict)
  semester semesters @relation(fields: [semester_id], references: [id], onDelete: Restrict)
  lsc      lscs      @relation(fields: [lsc_id], references: [id], onDelete: Restrict)
  student_courses student_courses[]
  learning_sessions learning_sessions[]

  @@index([user_id])
  @@index([roll_number])
  @@index([program_id])
  @@index([semester_id])
  @@index([lsc_id])
  @@index([phone_number])
  @@map("students")
}

model admins {
  id         String   @id @default(cuid())
  user_id    String   @unique
  full_name  String
  created_at DateTime @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("admins")
}

model programs {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  status      Status   @default(ACTIVE)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  semesters semesters[]
  courses   courses[]
  students  students[]

  @@index([code])
  @@index([status])
  @@map("programs")
}

model semesters {
  id              String   @id @default(cuid())
  program_id      String
  semester_number Int
  name            String
  status          Status   @default(ACTIVE)

  // Relations
  program programs @relation(fields: [program_id], references: [id], onDelete: Cascade)
  courses courses[]
  students students[]

  @@unique([program_id, semester_number])
  @@index([program_id])
  @@index([status])
  @@map("semesters")
}

model lscs {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  location String?
  status   Status @default(ACTIVE)

  // Relations
  students students[]

  @@index([code])
  @@index([status])
  @@map("lscs")
}

model courses {
  id          String  @id @default(cuid())
  program_id  String
  semester_id String
  name        String
  code        String
  description String?

  // Relations
  program  programs  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  semester semesters @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  student_courses student_courses[]
  learning_sessions learning_sessions[]

  @@unique([program_id, semester_id, code])
  @@index([program_id])
  @@index([semester_id])
  @@index([code])
  @@map("courses")
}

// ── Phase 3: Student course access + learning session storage ──────────────

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model student_courses {
  id          String           @id @default(cuid())
  student_id  String
  course_id   String
  status      EnrollmentStatus @default(ACTIVE)
  assigned_at DateTime         @default(now())
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  // Relations
  student students @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  courses  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  learning_sessions learning_sessions[]

  @@unique([student_id, course_id])
  @@index([student_id])
  @@index([course_id])
  @@index([status])
  @@map("student_courses")
}

model learning_sessions {
  id                String        @id @default(cuid())
  student_id        String
  course_id         String
  unit_id           String?
  chapter_id        String?
  started_at        DateTime      @default(now())
  ended_at          DateTime?
  duration_seconds  Int           @default(0)
  completion_status SessionStatus @default(IN_PROGRESS)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  // Relations
  student        students        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course         courses         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  student_course student_courses? @relation(fields: [student_course_id], references: [id], onDelete: SetNull)
  student_course_id String?

  @@index([student_id, started_at])
  @@index([student_id, course_id])
  @@index([completion_status])
  @@map("learning_sessions")
}

model sessions {
  id                 String    @id @default(cuid())
  user_id            String
  refresh_token_hash String    @unique
  device_info        String?
  ip_address         String?
  created_at         DateTime  @default(now())
  expires_at         DateTime
  revoked_at         DateTime?

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token_hash])
  @@index([expires_at])
  @@index([revoked_at])
  @@map("sessions")
}

model password_resets {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  // Relations
  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
  @@map("password_resets")
}

model audit_logs {
  id          String   @id @default(cuid())
  user_id     String?
  action      String
  ip_address  String?
  device_info String?
  created_at  DateTime @default(now())
  metadata    Json?

  // Relations
  user users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}
